# FUDARI Environment Variables
# Copy this file to .env and fill in actual values — NEVER commit .env to git

# Database
DATABASE_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_strong_redis_password

# JWT — minimum 32 random characters, use: openssl rand -hex 32
JWT_SECRET=change_me_minimum_32_char_random_secret

# Runtime profile — `prod` activates application-prod.properties, which has no
# fallbacks: any missing variable below stops the backend from starting.
SPRING_PROFILES_ACTIVE=prod

# Database connection (backend container talks to the postgres service)
DATABASE_URL=jdbc:postgresql://postgres:5432/tufixit
DATABASE_USERNAME=postgres

# Public base URL, used for links inside emails and SMS
APP_BASE_URL=https://fudari.co

# First admin account created by DataSeeder on an empty database.
# Set these to private values — the dev fallback is publicly known.
SEED_ADMIN_EMAIL=admin@fudari.co
SEED_ADMIN_PASSWORD=change_me_strong_admin_password

# Reject unsigned Twilio webhooks in production
TWILIO_VALIDATE_SIGNATURE=true

# M-Pesa (for production)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://api.fudari.co/api/payments/mpesa/stk-callback

# Africa's Talking SMS
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=tufixit
AT_SENDER_ID=

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=set_a_strong_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Twilio (required if using TWILIO provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Defaults to the Twilio sandbox number — set your provisioned sender for production
TWILIO_WHATSAPP_FROM=+14155238886

# WhatsApp provider selection: "twilio" or "meta"
WHATSAPP_PROVIDER=twilio
WHATSAPP_FALLBACK_ENABLED=false

# Backend CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://fudari.co,https://www.fudari.co

# Mail (SMTP) — used for onboarding & transactional email
# Namecheap Private Email: mail.privateemail.com, 587 (STARTTLS) or 465 (SSL).
# MAIL_USERNAME is the full mailbox address, and MAIL_FROM_ADDRESS must match it
# (or be an alias of it) or Namecheap rejects the send with "553 sender rejected".
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@fudari.co
MAIL_PASSWORD=change_me_smtp_password
MAIL_FROM_NAME=FUDARI
MAIL_FROM_ADDRESS=no-reply@fudari.co
MAIL_ENABLED=true

# Optional host port bindings — keep both on loopback; nginx is the only
# service that should publish ports on the public interface.
BACKEND_PORT_BIND=127.0.0.1:8080
FRONTEND_PORT_BIND=127.0.0.1:3000

# nginx config to mount: nginx-bootstrap.conf for first-time cert issuance,
# then nginx.conf once certificates exist.
NGINX_CONF=nginx.conf

# Frontend
NEXT_PUBLIC_API_URL=https://api.fudari.co/api
