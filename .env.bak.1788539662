# ── Spring profile ──────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Frontend API URL (local backend) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ── CORS (allow local frontend) ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Mail ────────────────────────────────────────────────────────────────────
# Set MAIL_ENABLED=false to skip email sending in dev
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@tufixit.com
MAIL_PASSWORD=replace_with_real_smtp_password
MAIL_FROM_NAME=TUFIXIT
MAIL_FROM_ADDRESS=no-reply@tufixit.com
MAIL_ENABLED=false

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
